# Caches (torch.compile, matplotlib, etc.)
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.so

# Virtual environments
.venv/
venv/
env/

# HPC site-local configuration (contains project-specific paths, not for sharing)
sc_uv_crowdrl/site.sh
sc_uv_crowdrl/python

# uv
uv.lock

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ONNX artifacts
*.onnx

# Jupyter
.ipynb_checkpoints/

# Example outputs (generated GIFs, videos, etc.)
examples/outputs/
ezgif-*.gif

# Logs
*.log
wandb/
runs/

# Reference papers / large binary resources
resources/

# Training experiment output directories (checkpoints, videos, plots, logs)
results_*/

# Diagnostic output directories (per-checkpoint analysis dumps)
diagnostic_*/

# Claude Code (personal/local settings; the shared .claude/CLAUDE.md stays tracked)
.claude/settings*.json

# Experimental configs are kept LOCAL (untracked). Lineage + learnings recorded in
# plan/agent_dynamics_refactor_merge_review.md. Only the baseline + canonical
# templates are tracked; new exp_/smoke_ configs are auto-ignored (use `git add -f`
# to deliberately track a new one).
configs/*.yaml
!configs/baseline.yaml
!configs/full_training.yaml
!configs/smoke_baseline.yaml

# One-off experiment launcher (hardcodes a local config + checkpoint path)
sc_uv_crowdrl/run_nomemory.sbatch

# Local result archives / run backups (kept locally, not tracked)
*.zip
*.bak*
MOST_PROMISING_*/
